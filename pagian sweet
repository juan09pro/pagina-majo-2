                <h3 class="font-display text-2xl font-bold text-pastel-cocoa mt-1 mb-3">${item.title}</h3>
                <p class="text-sm sm:text-base text-pastel-cocoa/90 leading-relaxed">${item.text}</p>
            `;
        }

        // 4. Selector de Ciudades (Bogotá, Quito, Lima)
        const cityData = {
            bogota: {
                flag: "🇨🇴",
                name: "Bogotá, Colombia (Suba - Villa María)",
                role: "Sede Matriz & Corazón Artesanal",
                desc: "Punto de origen donde la empresa familiar consolidó su reputación gracias a la calidad de sus tortas y la calidez de sus fundadores. Aquí se estandariza el catálogo digital y la identidad visual antes de dar el salto internacional.",
                actions: ["Digitalización del catálogo de productos", "Capacitación en herramientas digitales al equipo", "Fidelización de clientes actuales del sector"]
            },
            quito: {
                flag: "🇪🇨",
                name: "Quito, Ecuador",
                role: "Mercado de Expansión Internacional 1",
                desc: "Estrategia enfocada en consumidores que valoran la repostería tradicional con presentación cuidada. Se analizan competidores locales para destacar el factor diferencial de Sweet Experience: recetas familiares con atención personalizada.",
                actions: ["Campañas visuales en Instagram y Facebook", "Actividades promocionales de lanzamiento en punto de venta", "Mensajes adaptados a celebraciones familiares quiteñas"]
            },
            lima: {
                flag: "🇵🇪",
                name: "Lima, Perú",
                role: "Mercado de Expansión Internacional 2",
                desc: "En un mercado gastronómico exigente como el limeño, la comunicación resalta la autenticidad, la dedicación artesanal y la experiencia dulce única, utilizando formatos dinámicos para captar audiencias jóvenes y familiares.",
                actions: ["Storytelling en TikTok mostrando la preparación artesanal", "Atención ágil y cotizaciones directas vía WhatsApp", "Alianzas y activaciones de degustación para posicionamiento"]
            }
        };

        function selectCity(cityKey) {
            document.querySelectorAll('.city-btn').forEach(btn => {
                btn.classList.remove('tab-active');
                btn.classList.add('text-pastel-cocoa');
            });
            const active = document.getElementById('city-' + cityKey);
            active.classList.add('tab-active');
            active.classList.remove('text-pastel-cocoa');

            const c = cityData[cityKey];
            const actionsHtml = c.actions.map(act => `
                <li class="flex items-center gap-2 text-xs sm:text-sm font-semibold text-pastel-cocoa bg-white/80 p-3 rounded-xl border border-pastel-pink">
                    <i class="fa-solid fa-circle-check text-pastel-rose"></i>
                    <span>${act}</span>
                </li>
            `).join('');

            document.getElementById('city-panel').innerHTML = `
                <div class="flex flex-col md:flex-row gap-6 items-start md:items-center justify-between mb-5">
                    <div>
                        <span class="px-3 py-1 rounded-full bg-pastel-rose/15 text-pastel-rose text-xs font-bold">${c.role}</span>
                        <h3 class="font-display text-2xl sm:text-3xl font-bold text-pastel-cocoa mt-2">${c.flag} ${c.name}</h3>
                    </div>
                </div>
                <p class="text-sm sm:text-base text-pastel-cocoa/90 leading-relaxed mb-6">${c.desc}</p>
                <h4 class="font-display font-bold text-sm uppercase tracking-wider text-pastel-cocoaLight mb-3">Acciones Clave en este Mercado:</h4>
                <ul class="grid grid-cols-1 md:grid-cols-3 gap-3">${actionsHtml}</ul>
            `;
        }

        // 5. Modales de Canales Digitales
        const channelsInfo = {
            web: {
                icon: "fa-solid fa-globe text-amber-500",
                title: "Página Web Corporativa",
                desc: "Eje central de la identidad visual. Permite presentar el catálogo completo de tortas, postres y dulces de manera organizada, transmitir la historia familiar y facilitar el contacto desde Bogotá, Quito y Lima."
            },
            instagram: {
                icon: "fa-brands fa-instagram text-pink-500",
                title: "Instagram",
                desc: "Vitrina visual principal para enamorar a través de fotografías de alta estética de los pasteles, detalles de decoración y testimonios de clientes felices."
            },
            tiktok: {
                icon: "fa-brands fa-tiktok text-purple-600",
                title: "TikTok",
                desc: "Canal creativo para mostrar el 'detrás de cámaras' de la repostería artesanal, la ternura y experiencia de los fundadores y tendencias dulces que conecten con nuevas audiencias."
            },
            facebook: {
                icon: "fa-brands fa-facebook text-blue-500",
                title: "Facebook",
                desc: "Ideal para conectar con el público familiar tradicional en Bogotá, Quito y Lima, difundiendo promociones de temporada y eventos especiales."
            },
            whatsapp: {
                icon: "fa-brands fa-whatsapp text-teal-600",
                title: "WhatsApp Business",
                desc: "Canal de conversión y cercanía. Mantiene la atención personalizada característica de Sweet Experience, permitiendo resolver dudas y personalizar pedidos rápidamente."
            }
        };

        function openChannelModal(key) {
            const info = channelsInfo[key];
            document.getElementById('channel-modal-body').innerHTML = `
                <div class="w-14 h-14 rounded-2xl bg-pastel-cream border border-pastel-pink flex items-center justify-center text-3xl mb-4">
                    <i class="${info.icon}"></i>
                </div>
                <h3 class="font-display text-2xl font-bold text-pastel-cocoa mb-2">${info.title}</h3>
                <p class="text-sm text-pastel-cocoa/90 leading-relaxed">${info.desc}</p>
            `;
            openModal('modal-channel');
        }

        // 6. Simulador de Crisis
        function simulateCrisis(type) {
            const box = document.getElementById('crisis-response');
            if (type === 'entrega') {
                box.innerHTML = `
                    <strong class="text-amber-700 block mb-1">✅ Protocolo de Logística Activado:</strong>
                    1. Contacto telefónico inmediato y empático con el cliente.<br>
                    2. Explicación transparente del estado del pedido y hora exacta de llegada.<br>
                    3. Compensación dulce de cortesía por las molestias ocasionadas.
                `;
            } else {
                box.innerHTML = `
                    <strong class="text-pastel-rose block mb-1">✅ Protocolo de Reputación Digital Activado:</strong>
                    1. Respuesta pública cordial en menos de 2 horas agradeciendo la retroalimentación.<br>
                    2. Traslado del caso a canal privado (WhatsApp) para solución personalizada.<br>
                    3. Seguimiento post-atención para asegurar la satisfacción total.
                `;
            }
        }

        // Funciones generales de Modales y Toast
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }
        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = message;
            toast.classList.remove('translate-y-24', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3000);
        }

        // Inicializar vistas por defecto al cargar
        window.addEventListener('DOMContentLoaded', () => {
            showW('what');
            selectCity('bogota');
        });
    </script>
</body>
