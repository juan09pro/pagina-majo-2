<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sweet Experience | Estrategia de Comunicación Corporativa</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Quicksand y Nunito para una estética dulce y moderna -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome para iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Nunito', 'sans-serif'],
                        display: ['Quicksand', 'sans-serif'],
                    },
                    colors: {
                        pastel: {
                            cream: '#FFFDF9',
                            pink: '#FFE5EC',
                            pinkDark: '#FFB3C6',
                            rose: '#FB6F92',
                            mint: '#E2ECE9',
                            mintDark: '#BEE1E6',
                            lavender: '#EAE4E9',
                            peach: '#FDE2E4',
                            vanilla: '#FFF1E6',
                            cocoa: '#5C4B51',
                            cocoaLight: '#8A757C'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Estilos personalizados suaves y animaciones creativas */
        body {
            background-color: #FFFDF9;
            color: #5C4B51;
            overflow-x: hidden;
        }
        .font-display {
            font-family: 'Quicksand', sans-serif;
        }
        /* Animación flotante para elementos decorativos */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(3deg); }
        }
        .animate-float {
            animation: float 5s ease-in-out infinite;
        }
        .animate-float-delayed {
            animation: float 6s ease-in-out 2s infinite;
        }
        /* Efecto cristal pastel */
        .pastel-glass {
            background: rgba(255, 255, 255, 0.82);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 179, 198, 0.4);
        }
        /* Transiciones suaves para modales y paneles */
        .tab-active {
            background-color: #FB6F92 !important;
            color: white !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px -4px rgba(251, 111, 146, 0.4);
        }
    </style>
</head>
<body class="antialiased selection:bg-pastel-pink selection:text-pastel-cocoa">

    <!-- Barra de Navegación Flotante -->
    <nav class="sticky top-0 z-40 pastel-glass shadow-sm transition-all">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Logo / Marca -->
                <div class="flex items-center space-x-3">
                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-pastel-rose to-pastel-pinkDark flex items-center justify-center text-white shadow-md">
                        <i class="fa-solid fa-cake-candles text-xl"></i>
                    </div>
                    <div>
                        <span class="font-display font-bold text-xl tracking-tight text-pastel-cocoa block leading-none">Sweet Experience</span>
                        <span class="text-xs font-semibold text-pastel-rose">Estrategia Corporativa</span>
                    </div>
                </div>

                <!-- Links Desktop -->
                <div class="hidden md:flex items-center space-x-6 text-sm font-bold">
                    <a href="#esencia" class="hover:text-pastel-rose transition">Esencia & Historia</a>
                    <a href="#matriz-w" class="hover:text-pastel-rose transition">Diagnóstico (5W)</a>
                    <a href="#expansion" class="hover:text-pastel-rose transition">Expansión Internacional</a>
                    <a href="#objetivos" class="hover:text-pastel-rose transition">Objetivos</a>
                    <a href="#fase2" class="hover:text-pastel-rose transition">Fase 2 & KPIs</a>
                </div>

                <!-- Botón Info Académica -->
                <button onclick="openModal('modal-creditos')" class="px-4 py-2.5 rounded-full bg-pastel-lavender hover:bg-pastel-pink text-pastel-cocoa font-bold text-xs sm:text-sm transition transform hover:scale-105 shadow-sm flex items-center gap-2">
                    <i class="fa-solid fa-graduation-cap text-pastel-rose"></i>
                    <span>Ficha Proyecto</span>
                </button>
            </div>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <header class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 bg-gradient-to-b from-pastel-pink/50 via-pastel-vanilla/40 to-pastel-cream">
        <!-- Elementos decorativos flotantes (SVG creativos) -->
        <div class="hidden lg:block absolute top-16 left-12 text-pastel-pinkDark/60 animate-float">
            <i class="fa-solid fa-cookie-bite text-6xl"></i>
        </div>
        <div class="hidden lg:block absolute bottom-20 right-16 text-pastel-mintDark animate-float-delayed">
            <i class="fa-solid fa-ice-cream text-7xl"></i>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <!-- Etiqueta superior -->
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/90 border border-pastel-pinkDark text-xs font-bold text-pastel-rose mb-6 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-pastel-rose animate-ping"></span>
                Fundación Universitaria Compensar • Strategic Corporate Communication 4313-6A
            </div>

            <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-pastel-cocoa tracking-tight mb-6 leading-tight">
                Llevando el sabor artesanal de <br class="hidden sm:inline">
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-pastel-rose to-amber-500">Sweet Experience</span> al mundo
            </h1>

            <p class="max-w-2xl mx-auto text-base sm:text-lg text-pastel-cocoaLight mb-10 leading-relaxed">
                Una estrategia integral de comunicación corporativa diseñada para transformar una tradición familiar de <strong>Suba-Villa María (Bogotá)</strong> hacia los mercados internacionales de <strong>Quito (Ecuador)</strong> y <strong>Lima (Perú)</strong>.
            </p>

            <!-- Botones interactivos principales -->
            <div class="flex flex-wrap justify-center gap-4">
                <button onclick="openModal('modal-abstract')" class="px-7 py-3.5 rounded-2xl bg-pastel-rose hover:bg-pink-500 text-white font-bold shadow-lg shadow-pastel-rose/30 transition transform hover:-translate-y-1 flex items-center gap-2">
                    <i class="fa-solid fa-book-open"></i>
                    <span>Leer Resumen Ejecutivo</span>
                </button>
                <a href="#expansion" class="px-7 py-3.5 rounded-2xl bg-white hover:bg-pastel-mint/50 text-pastel-cocoa border-2 border-pastel-mintDark font-bold shadow-sm transition transform hover:-translate-y-1 flex items-center gap-2">
                    <i class="fa-solid fa-earth-americas text-teal-600"></i>
                    <span>Explorar Ruta Bogotá → Quito & Lima</span>
                </a>
            </div>

            <!-- Tarjetas rápidas de métricas / datos clave -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto mt-14">
                <div class="p-4 rounded-3xl bg-white/80 border border-pastel-pink shadow-sm">
                    <div class="text-2xl font-extrabold text-pastel-rose font-display">Suba</div>
                    <div class="text-xs font-semibold text-pastel-cocoaLight">Origen Familiar (Bogotá)</div>
                </div>
                <div class="p-4 rounded-3xl bg-white/80 border border-pastel-mintDark shadow-sm">
                    <div class="text-2xl font-extrabold text-teal-600 font-display">2 Países</div>
                    <div class="text-xs font-semibold text-pastel-cocoaLight">Expansión: Ecuador y Perú</div>
                </div>
                <div class="p-4 rounded-3xl bg-white/80 border border-pastel-lavender shadow-sm">
                    <div class="text-2xl font-extrabold text-purple-500 font-display">2034</div>
                    <div class="text-xs font-semibold text-pastel-cocoaLight">Visión de Reconocimiento</div>
                </div>
                <div class="p-4 rounded-3xl bg-white/80 border border-amber-200 shadow-sm">
                    <div class="text-2xl font-extrabold text-amber-500 font-display">5 Valores</div>
                    <div class="text-xs font-semibold text-pastel-cocoaLight">ADN de Marca Artesanal</div>
                </div>
            </div>
        </div>
    </header>

    <!-- SECCIÓN 1: ESENCIA, HISTORIA, MISIÓN, VISIÓN Y VALORES INTERACTIVOS -->
    <section id="esencia" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <span class="px-3 py-1 rounded-full bg-pastel-mint text-teal-800 text-xs font-bold uppercase tracking-wider">Fase de Identificación</span>
            <h2 class="font-display text-3xl sm:text-4xl font-bold text-pastel-cocoa mt-2">El Corazón de Sweet Experience</h2>
            <p class="text-pastel-cocoaLight mt-2 max-w-xl mx-auto">Haz clic en los botones de cada pilar para descubrir cómo combinamos la experiencia tradicional con la innovación digital.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Tarjeta Historia -->
            <div class="rounded-3xl p-7 bg-pastel-peach/60 border border-pastel-pinkDark/40 shadow-sm flex flex-col justify-between transition hover:shadow-md">
                <div>
                    <div class="w-12 h-12 rounded-2xl bg-white text-pastel-rose flex items-center justify-center text-xl shadow-sm mb-5">
                        <i class="fa-solid fa-heart"></i>
                    </div>
                    <h3 class="font-display text-2xl font-bold text-pastel-cocoa mb-3">Nuestra Historia</h3>
                    <p class="text-sm text-pastel-cocoa/90 leading-relaxed mb-4">
                        Nacida en <strong>Suba-Villa María, Bogotá</strong>, Sweet Experience es una empresa familiar liderada por adultos mayores que conocen a la perfección los gustos de sus clientes, destacando por el cuidado artesanal y trato cálido.
                    </p>
                </div>
                <button onclick="toggleDetail('hist-extra')" class="w-full py-2.5 px-4 rounded-xl bg-white hover:bg-pastel-rose hover:text-white text-pastel-rose font-bold text-sm transition flex items-center justify-between shadow-sm">
                    <span>Ver Reto Digital Detectado</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                <div id="hist-extra" class="hidden mt-3 p-3.5 rounded-xl bg-white/90 text-xs text-pastel-cocoa leading-relaxed border border-pastel-pink">
                    <strong>El Desafío:</strong> Al estar conformada por adultos mayores, el equipo posee conocimiento limitado en herramientas digitales y redes sociales, frenando su alcance hacia nuevas audiencias.
                </div>
            </div>

            <!-- Tarjeta Misión -->
            <div class="rounded-3xl p-7 bg-pastel-mint/60 border border-pastel-mintDark shadow-sm flex flex-col justify-between transition hover:shadow-md">
                <div>
                    <div class="w-12 h-12 rounded-2xl bg-white text-teal-600 flex items-center justify-center text-xl shadow-sm mb-5">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </div>
                    <h3 class="font-display text-2xl font-bold text-pastel-cocoa mb-3">Misión</h3>
                    <p class="text-sm text-pastel-cocoa/90 leading-relaxed mb-4">
                        Ofrecer pasteles, postres y dulces para los momentos más importantes y especiales de nuestros clientes, a través de productos hechos con <strong>amor y dedicación</strong>, brindando un servicio único que genere plena satisfacción.
                    </p>
                </div>
                <button onclick="toggleDetail('mision-extra')" class="w-full py-2.5 px-4 rounded-xl bg-white hover:bg-teal-600 hover:text-white text-teal-700 font-bold text-sm transition flex items-center justify-between shadow-sm">
                    <span>¿Cómo lo cumplimos?</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                <div id="mision-extra" class="hidden mt-3 p-3.5 rounded-xl bg-white/90 text-xs text-pastel-cocoa leading-relaxed border border-pastel-mintDark">
                    Manteniendo recetas caseras de alta calidad, presentación impecable y una atención personalizada que hace sentir especial a cada comprador.
                </div>
            </div>

            <!-- Tarjeta Visión 2034 -->
            <div class="rounded-3xl p-7 bg-pastel-lavender/70 border border-purple-200 shadow-sm flex flex-col justify-between transition hover:shadow-md">
                <div>
                    <div class="w-12 h-12 rounded-2xl bg-white text-purple-600 flex items-center justify-center text-xl shadow-sm mb-5">
                        <i class="fa-solid fa-binoculars"></i>
                    </div>
                    <h3 class="font-display text-2xl font-bold text-pastel-cocoa mb-3">Visión 2034</h3>
                    <p class="text-sm text-pastel-cocoa/90 leading-relaxed mb-4">
                        Para el año <strong>2034</strong>, Sweet Experience busca consolidarse como una marca reconocida en el mercado de la repostería, abriendo nuevos puntos de venta internacionales e integrando herramientas digitales.
                    </p>
                </div>
                <button onclick="toggleDetail('vision-extra')" class="w-full py-2.5 px-4 rounded-xl bg-white hover:bg-purple-600 hover:text-white text-purple-700 font-bold text-sm transition flex items-center justify-between shadow-sm">
                    <span>Promesa de Identidad</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                <div id="vision-extra" class="hidden mt-3 p-3.5 rounded-xl bg-white/90 text-xs text-pastel-cocoa leading-relaxed border border-purple-200">
                    Crecer y modernizar la comunicación con los clientes <strong>sin perder jamás su esencia familiar</strong> ni las cualidades artesanales que la hacen única.
                </div>
            </div>
        </div>

        <!-- Botonera Interactiva de los 5 Valores Corporativos -->
        <div class="mt-12 p-8 rounded-3xl bg-white border border-pastel-pink shadow-sm">
            <h4 class="font-display text-xl font-bold text-center text-pastel-cocoa mb-2">Nuestros 5 Pilares de Valor</h4>
            <p class="text-center text-xs text-pastel-cocoaLight mb-6">Selecciona cada valor para ver cómo se refleja en la estrategia de comunicación:</p>
            
            <div class="flex flex-wrap justify-center gap-3 mb-6" id="valores-buttons">
                <button onclick="selectValor(0)" class="valor-btn tab-active px-5 py-2.5 rounded-full bg-pastel-pink/50 text-pastel-cocoa font-bold text-sm transition">✨ Calidad</button>
                <button onclick="selectValor(1)" class="valor-btn px-5 py-2.5 rounded-full bg-pastel-mint/70 text-pastel-cocoa font-bold text-sm transition">🤝 Cercanía con los clientes</button>
                <button onclick="selectValor(2)" class="valor-btn px-5 py-2.5 rounded-full bg-pastel-vanilla text-pastel-cocoa font-bold text-sm transition">🧁 Dedicación</button>
                <button onclick="selectValor(3)" class="valor-btn px-5 py-2.5 rounded-full bg-pastel-lavender text-pastel-cocoa font-bold text-sm transition">📚 Aprendizaje</button>
                <button onclick="selectValor(4)" class="valor-btn px-5 py-2.5 rounded-full bg-pastel-peach text-pastel-cocoa font-bold text-sm transition">🌱 Adaptación</button>
            </div>

            <div id="valor-display" class="max-w-2xl mx-auto p-5 rounded-2xl bg-pastel-cream border border-pastel-pinkDark/50 text-center transition-all">
                <h5 id="valor-title" class="font-display font-bold text-lg text-pastel-rose mb-1">Calidad Artesanal</h5>
                <p id="valor-desc" class="text-sm text-pastel-cocoa">Selección cuidadosa de ingredientes y presentación impecable en cada torta y postre, comunicada visualmente en catálogos digitales de alta estética.</p>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 2: JUSTIFICACIÓN ESTRATÉGICA INTERACTIVA (WHAT, HOW, WHY, WHAT FOR) -->
    <section id="matriz-w" class="py-16 bg-pastel-vanilla/60 border-y border-amber-100">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-10">
                <span class="px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-bold uppercase">Justificación del Proyecto</span>
                <h2 class="font-display text-3xl sm:text-4xl font-bold text-pastel-cocoa mt-2">Las 4 Preguntas Clave de la Estrategia</h2>
                <p class="text-pastel-cocoaLight mt-2">Explora los botones para comprender el fundamento estratégico de nuestra intervención.</p>
            </div>

            <!-- Pestañas creativas -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
                <button onclick="showW('what')" id="btn-what" class="w-tab tab-active p-4 rounded-2xl bg-white border border-pastel-pink font-display font-bold text-base shadow-sm transition flex flex-col items-center gap-1">
                    <span class="text-xs uppercase opacity-75">¿Qué?</span>
                    <span>WHAT</span>
                </button>
                <button onclick="showW('how')" id="btn-how" class="w-tab p-4 rounded-2xl bg-white border border-pastel-pink font-display font-bold text-base text-pastel-cocoa shadow-sm transition flex flex-col items-center gap-1">
                    <span class="text-xs uppercase opacity-75">¿Cómo?</span>
                    <span>HOW</span>
                </button>
                <button onclick="showW('why')" id="btn-why" class="w-tab p-4 rounded-2xl bg-white border border-pastel-pink font-display font-bold text-base text-pastel-cocoa shadow-sm transition flex flex-col items-center gap-1">
                    <span class="text-xs uppercase opacity-75">¿Por qué?</span>
                    <span>WHY</span>
                </button>
                <button onclick="showW('whatfor')" id="btn-whatfor" class="w-tab p-4 rounded-2xl bg-white border border-pastel-pink font-display font-bold text-base text-pastel-cocoa shadow-sm transition flex flex-col items-center gap-1">
                    <span class="text-xs uppercase opacity-75">¿Para qué?</span>
                    <span>WHAT FOR</span>
                </button>
            </div>

            <!-- Contenedor de información dinámica -->
            <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-md border border-pastel-pinkDark/30 relative overflow-hidden">
                <div id="w-content" class="transition-all duration-300">
                    <!-- Se llena vía JS -->
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 3: EXPANSIÓN INTERNACIONAL Y ECOSISTEMA DIGITAL (BOGOTÁ -> QUITO & LIMA) -->
    <section id="expansion" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <span class="px-3 py-1 rounded-full bg-pastel-pink text-pastel-rose text-xs font-bold uppercase">Mercados & Canales Digitales</span>
            <h2 class="font-display text-3xl sm:text-4xl font-bold text-pastel-cocoa mt-2">Ruta de Expansión y Ecosistema Digital</h2>
            <p class="text-pastel-cocoaLight mt-2 max-w-2xl mx-auto">Selecciona una ciudad para ver el enfoque estratégico adaptado a las preferencias culturales de cada mercado.</p>
        </div>

        <!-- Selector interactivo de Ciudades -->
        <div class="flex flex-wrap justify-center gap-4 mb-10">
            <button onclick="selectCity('bogota')" id="city-bogota" class="city-btn tab-active px-6 py-3 rounded-2xl bg-white border-2 border-pastel-rose font-bold text-sm sm:text-base transition flex items-center gap-2 shadow-sm">
                <span>🇨🇴</span> Bogotá (Suba - Sede Matriz)
            </button>
            <button onclick="selectCity('quito')" id="city-quito" class="city-btn px-6 py-3 rounded-2xl bg-white border-2 border-pastel-mintDark text-pastel-cocoa font-bold text-sm sm:text-base transition flex items-center gap-2 shadow-sm">
                <span>🇪🇨</span> Quito, Ecuador (Mercado Meta 1)
            </button>
            <button onclick="selectCity('lima')" id="city-lima" class="city-btn px-6 py-3 rounded-2xl bg-white border-2 border-purple-200 text-pastel-cocoa font-bold text-sm sm:text-base transition flex items-center gap-2 shadow-sm">
                <span>🇵🇪</span> Lima, Perú (Mercado Meta 2)
            </button>
        </div>

        <!-- Panel Detallado de la Ciudad Seleccionada -->
        <div id="city-panel" class="rounded-3xl p-6 sm:p-10 bg-gradient-to-br from-white to-pastel-pink/30 border border-pastel-pinkDark/40 shadow-md mb-14">
            <!-- Contenido dinámico -->
        </div>

        <!-- Botones Interactivos de Canales Digitales Propuestos -->
        <h3 class="font-display text-2xl font-bold text-center text-pastel-cocoa mb-6">Canales Digitales de la Estrategia (Haz clic para ver su rol)</h3>
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
            <button onclick="openChannelModal('web')" class="p-5 rounded-3xl bg-pastel-vanilla hover:bg-amber-100 border border-amber-200 text-center transition transform hover:-translate-y-1 shadow-sm group">
                <div class="w-12 h-12 mx-auto rounded-2xl bg-white text-amber-500 flex items-center justify-center text-2xl mb-3 shadow-sm group-hover:scale-110 transition">
                    <i class="fa-solid fa-globe"></i>
                </div>
                <span class="font-display font-bold text-sm block text-pastel-cocoa">Página Web</span>
                <span class="text-[11px] text-pastel-cocoaLight">Catálogo & Marca</span>
            </button>

            <button onclick="openChannelModal('instagram')" class="p-5 rounded-3xl bg-pastel-pink/60 hover:bg-pastel-pink border border-pastel-pinkDark text-center transition transform hover:-translate-y-1 shadow-sm group">
                <div class="w-12 h-12 mx-auto rounded-2xl bg-white text-pink-500 flex items-center justify-center text-2xl mb-3 shadow-sm group-hover:scale-110 transition">
                    <i class="fa-brands fa-instagram"></i>
                </div>
                <span class="font-display font-bold text-sm block text-pastel-cocoa">Instagram</span>
                <span class="text-[11px] text-pastel-cocoaLight">Vitrina Visual</span>
            </button>

            <button onclick="openChannelModal('tiktok')" class="p-5 rounded-3xl bg-pastel-lavender hover:bg-purple-200/70 border border-purple-200 text-center transition transform hover:-translate-y-1 shadow-sm group">
                <div class="w-12 h-12 mx-auto rounded-2xl bg-white text-purple-600 flex items-center justify-center text-2xl mb-3 shadow-sm group-hover:scale-110 transition">
                    <i class="fa-brands fa-tiktok"></i>
                </div>
                <span class="font-display font-bold text-sm block text-pastel-cocoa">TikTok</span>
                <span class="text-[11px] text-pastel-cocoaLight">Storytelling Familiar</span>
            </button>

            <button onclick="openChannelModal('facebook')" class="p-5 rounded-3xl bg-blue-50 hover:bg-blue-100/80 border border-blue-200 text-center transition transform hover:-translate-y-1 shadow-sm group">
                <div class="w-12 h-12 mx-auto rounded-2xl bg-white text-blue-500 flex items-center justify-center text-2xl mb-3 shadow-sm group-hover:scale-110 transition">
                    <i class="fa-brands fa-facebook"></i>
                </div>
                <span class="font-display font-bold text-sm block text-pastel-cocoa">Facebook</span>
                <span class="text-[11px] text-pastel-cocoaLight">Comunidad & Familias</span>
